{
  "settings": {
    "defaultTimeout": "30s",
    "authKey": "${GLOBAL_MCP_KEY}"
  },
  "embeddings": {
    "apiKey": "${OPENAI_API_KEY}",
    "model": "text-embedding-3-small"
  },
  "identities": {
    "admin": {
      "token": "admin-secret-token",
      "allowed_servers": ["*"],
      "allowed_tools": ["*"]
    },
    "guest-agent": {
      "token": "guest-agent-token",
      "allowed_servers": ["brave-search", "github"],
      "allowed_tools": ["search_*", "get_*", "list_*"],
      "read_only": true
    },
    "developer-alice": {
      "token": "alice-personal-token",
      "allowed_servers": ["github", "postgres-analytics", "remote-gateway"],
      "upstream_user_map": {
        "github": "alice_github_user",
        "postgres-analytics": "app_user_alice"
      },
      "upstream_headers": {
        "remote-gateway": {
          "Authorization": "Bearer op://Work/Gateway/alice_token"
        },
        "github": {
          "Authorization": "Bearer env://ALICE_GITHUB_TOKEN"
        }
      }
    },
    "developer-bob": {
      "token": "bob-personal-token",
      "allowed_servers": ["remote-gateway"],
      "upstream_headers": {
        "remote-gateway": {
          "Authorization": "Bearer op://Work/Gateway/bob_token"
        }
      }
    }
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "GitHub repository management: issues, pull requests, commits, branches, and code search.",
      "timeout": "45s"
    },
    "postgres-analytics": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/analytics"],
      "description": "Read-only PostgreSQL database queries, metrics, and schema inspection.",
      "read_only": true,
      "cache_ttl": "5m"
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}"
      },
      "description": "Slack workspace messaging: channel lookups, message posting, and thread replies.",
      "blocked_tools": ["delete_channel", "kick_user"]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Real-time web search, news aggregation, and URL lookup.",
      "cache_ttl": "15m"
    },
    "remote-gateway": {
      "url": "https://mcp.internal.company.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GATEWAY_TOKEN}"
      },
      "description": "Internal enterprise APIs, customer data lookups, and billing services."
    }
  }
}
