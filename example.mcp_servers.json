{
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": ["-y", "@artymclabin/gmail-mcp"]
    },
    "orders-mcp": {
      "command": "node",
      "args": ["/path/to/orders-mcp/src/stdio.js"]
    },
    "home-assistant": {
      "url": "http://192.168.1.199:8086/mcp"
    },
    "hindsight": {
      "url": "http://192.168.1.199:9000/mcp/",
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN_HERE"
      }
    }
  }
}
